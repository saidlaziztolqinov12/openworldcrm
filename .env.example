# ---------------------------------------------------------------------------
# Server-side only. NEVER prefix these with VITE_ — Vite inlines VITE_* values
# into the production JavaScript bundle, where anyone can read them.
# ---------------------------------------------------------------------------

# Telegram bot token from @BotFather. Used by api/send-telegram.ts and
# api/telegram-webhook.ts to message parents.
TELEGRAM_BOT_TOKEN=""

# Shared secret passed to Telegram's setWebhook(secret_token: ...) and verified
# on every inbound update. Any random string; without it the webhook is refused.
#   curl -X POST "https://api.telegram.org/bot<TOKEN>/setWebhook" \
#     -H "Content-Type: application/json" \
#     -d '{"url":"https://<your-domain>/api/telegram-webhook","secret_token":"<this value>"}'
TELEGRAM_WEBHOOK_SECRET=""

# Firebase service account JSON, on a single line. Required for push
# notifications (api/send-push.ts). Firebase Console -> Project settings ->
# Service accounts -> Generate new private key.
FIREBASE_SERVICE_ACCOUNT=""

# Comma-separated origins allowed to call the API routes. Include the WebView
# origins as well if you ship the Capacitor app, otherwise the mobile build is
# blocked by CORS:
#   https://crm.example.uz,https://localhost,capacitor://localhost
ALLOWED_ORIGIN=""

# ---------------------------------------------------------------------------
# Client-side. These ARE shipped in the browser bundle — never put secrets here.
# ---------------------------------------------------------------------------

# Absolute origin of the deployed API. Required for the Capacitor Android/iOS
# build, where relative /api/... requests resolve to the local WebView instead.
# Can stay empty for the plain web build.
VITE_API_BASE_URL=""

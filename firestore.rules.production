rules_version = '2';

// Target rules, to be deployed once the app signs in with Firebase
// Authentication. Rename over firestore.rules and run:
//   firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return signedIn() && role() == 'admin';
    }

    // Staff directory: everyone signed in can read colleagues; only an admin
    // may create or modify accounts. `password` must never be stored here.
    match /users/{userId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Payroll is admin-only. It used to stream into every teacher's browser.
    match /salary_advances/{advanceId} {
      allow read, write: if isAdmin();
    }

    // Student and cohort records: readable by any signed-in staff member,
    // writable by admins and by teachers (who record attendance).
    match /students/{studentId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /groups/{groupId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /attendance_records/{recordId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /notifications/{notificationId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    // Audit trail: append-only, never edited or deleted from the client.
    match /group_logs/{logId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // Anything not named above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
